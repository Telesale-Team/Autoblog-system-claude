# .env — Server configuration template
# Copy to /home/ubuntu/peyo-agent/.env and fill in values

SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=192.168.1.203,localhost

# Database — set USE_MYSQL=False to use SQLite (default/easiest)
USE_MYSQL=False

# MySQL (only if USE_MYSQL=True)
# DB_NAME=peyo_agent
# DB_USER=peyo_user
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=3306

# Email (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password

# reCAPTCHA (optional — leave empty to disable)
# RECAPTCHA_PUBLIC_KEY=
# RECAPTCHA_PRIVATE_KEY=
